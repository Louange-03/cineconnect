PORT=
DATABASE_URL=postgresql://cineconnect:cineconnect@localhost:5437/cineconnect
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Password reset (forgot/reset password)
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_EMAIL_SUBJECT=Réinitialisation du mot de passe
# Local sans SMTP : le lien de reset est affiché dans la console serveur ;
# si true, l’API peut aussi renvoyer resetUrl au front (désactiver en production).
PASSWORD_RESET_DEV_RETURN_LINK=true

# SMTP — pour recevoir les vrais e-mails (« mot de passe oublié »)
# Renseigner les 5 variables ci-dessous + FRONTEND_URL (URL exacte du site dans l’e-mail).
#
# Exemple Gmail (compte avec « mot de passe d’application ») :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=votre@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#   MAIL_FROM=Cineconnect <votre@gmail.com>
#
# Exemple Outlook / Hotmail :
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#
# Après redémarrage du backend, la demande « mot de passe oublié » envoie un vrai message.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

OMDB_API_KEY=   # clé OMDb (ex: 1df456d6) — backend + script seed_omdb_massive

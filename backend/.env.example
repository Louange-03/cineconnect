PORT=3001
DATABASE_URL=postgresql://cineconnect:cineconnect@localhost:5437/cineconnect
JWT_SECRET=change_moi_en_une_phrase_longue_super_secrete
FRONTEND_URL=http://localhost:5173
OMDB_API_KEY=your_omdb_key

# Password reset
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_EMAIL_SUBJECT=Reinitialisation du mot de passe
# false en prod ; true seulement en dev local pour retourner resetUrl dans la reponse
PASSWORD_RESET_DEV_RETURN_LINK=false

# Choix provider mail: auto | mailgun | smtp
MAIL_PROVIDER=mailgun

# Mailgun (recommande)
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_FROM=CineConnect <postmaster@mg.your-domain.com>
# EU: https://api.eu.mailgun.net
# US: https://api.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net

# SMTP (optionnel, fallback si MAIL_PROVIDER=auto)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

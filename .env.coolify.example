# =============================================================================
# Coolify : stack dans docker-compose.yaml (complet). docker-compose.coolify.yml = alias include.
# =============================================================================
# Apres creation de la ressource Docker Compose depuis Git, assigne les domaines
# aux services `web` et `api` avec le port interne 8080, par ex. :
#   https://app.ton-domaine.com:8080  -> service web
#   https://api.ton-domaine.com:8080  -> service api
#
# Coolify (v4.0.0-beta.411+) genere alors les variables magiques utilisees par le compose :
#   SERVICE_URL_WEB_8080   -> FRONTEND_URL + build VITE_* (fallback)
#   SERVICE_URL_API_8080   -> VITE_API_URL / VITE_SOCKET_URL (fallback)
#   SERVICE_PASSWORD_POSTGRES ou SERVICE_PASSWORD_DB -> mot de passe Postgres (fallback)
#   SERVICE_BASE64_64_API  -> JWT_SECRET (fallback)
#
# Tu n’as rien a copier-coller pour ces valeurs si tout est vert dans Coolify.
# Surcharge : definis manuellement FRONTEND_URL, VITE_API_URL, VITE_SOCKET_URL,
# POSTGRES_PASSWORD ou JWT_SECRET dans l’UI Coolify (prioritaire sur les fallbacks).
#
# Deploiement continu : GitHub secret COOLIFY_WEBHOOK_URL + workflow deploy-coolify.yml
# ou en local : ./scripts/trigger-coolify-deploy.ps1
#
# CORS : si la console navigateur signale des blocages, ajoute sur l’API dans Coolify :
# CORS_EXTRA_ORIGINS=http://web-xxx.sslip.io,https://web-xxx.sslip.io
# =============================================================================

# --- Optionnel (fonctionnalites) ---
OMDB_API_KEY=

MAIL_PROVIDER=auto
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_BASE_URL=https://api.mailgun.net

PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_EMAIL_SUBJECT=Reinitialisation du mot de passe
PASSWORD_RESET_DEV_RETURN_LINK=false

POSTGRES_USER=cineconnect
POSTGRES_DB=cineconnect

# =============================================================================
# Test local du fichier compose (sans Coolify) : exporte des faux SERVICE_* :
#   SERVICE_URL_WEB_8080=https://localhost:8081
#   SERVICE_URL_API_8080=https://localhost:8082
#   SERVICE_PASSWORD_DB=devonly
#   SERVICE_BASE64_64_API=012345678901234567890123456789012345678901234567890123456789012
# puis : docker compose -f docker-compose.coolify.yml up --build
# =============================================================================
